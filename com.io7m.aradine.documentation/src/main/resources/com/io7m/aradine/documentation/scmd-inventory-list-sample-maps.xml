  <Subsection title="Name">
    <Paragraph>
      <Term type="command">list-sample-maps</Term>
       - List sample maps in the local inventory.
    </Paragraph>
  </Subsection>
  <Subsection title="Description">
    <Paragraph>
      The 
      <Term type="command">list-sample-maps</Term>
       command lists sample maps installed in the local inventory.
    </Paragraph>
  </Subsection>
  <xi:include href="scmd-inventory-list-sample-maps-parameters.xml"/>
  <Subsection title="Examples">
    <FormalItem title="Example" type="example">
      <Verbatim><![CDATA[
$ aradine-cli inventory list-sample-maps
[ {
